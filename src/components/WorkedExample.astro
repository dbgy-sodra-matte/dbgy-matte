---
import { marked } from 'marked';
import { kursiveraHtml } from '../lib/variabler';
import { brakHtml } from '../lib/brak.mjs';

interface Props {
  /** Markdown-källa för exemplet. */
  markdown: string;
  /** Rubrik. Default: "Genomgång — steg för steg". */
  title?: string;
  /** Hopfallbart block (omläsningen). */
  collapsible?: boolean;
  /** Kursivera variabler i uttryck (matematisk typografi). Omlasningen. */
  mattetyp?: boolean;
}

const { markdown, title = 'Genomgång, steg för steg', collapsible = false, mattetyp = false } = Astro.props;
const Wrapper = collapsible ? 'details' : 'section';
const Head = collapsible ? 'summary' : 'header';

marked.setOptions({
  gfm: true,
  breaks: false,
});

const parsed = await marked.parse(markdown);
// Bråken först, kursiveringen sedan — brakHtml() letar i ren text och skulle
// inte känna igen "x/4" när x redan sitter i en <i>-tagg. Se src/lib/brak.mjs.
const html = mattetyp ? kursiveraHtml(brakHtml(parsed)) : parsed;
---

<Wrapper class="worked-example">
  <Head class="we-header">
    <span class="we-icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 11l3 3L22 4"></path>
        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
      </svg>
    </span>
    <span class="we-title">{title}</span>
  </Head>
  <div class="we-body" set:html={html}></div>
</Wrapper>

<style>
  details.worked-example > summary.we-header {
    cursor: pointer;
    list-style: none;
    user-select: none;
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: 0;
  }
  details.worked-example > summary.we-header::-webkit-details-marker { display: none; }
  details.worked-example > summary.we-header::after {
    content: "▾";
    margin-left: auto;
    color: var(--muted);
    transition: transform var(--duration) var(--ease-out);
  }
  details.worked-example[open] > summary.we-header::after { transform: rotate(180deg); }
  details.worked-example[open] > summary.we-header {
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--line);
  }

  .worked-example {
    margin: 22px 0;
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-md);
    padding: 18px 22px 20px;
    box-shadow: var(--shadow-xs), var(--inset-highlight);
    transition: box-shadow var(--duration) var(--ease-out);
  }
  @media (hover: hover) {
    .worked-example:hover { box-shadow: var(--shadow-sm), var(--inset-highlight); }
  }
  .we-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--line);
  }
  .we-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    color: var(--accent);
    flex-shrink: 0;
  }
  .we-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  @media (max-width: 540px) {
  }

  /* Markdown-genererat innehåll.
   *
   * ⚠️ ALLA selektorer under .we-body MÅSTE vara :global().
   * Innehållet kommer från `set:html` (marked → HTML-sträng) och får därför
   * INGA data-astro-cid-attribut. Astros scopade CSS kompilerar
   * `.we-body p` till `.we-body[cid] p[cid]`, vilket aldrig matchar ett <p>
   * som injicerats som rå HTML — reglerna föll bort helt och texten fick
   * webbläsarens standardmarginaler. Det såg ut som "konstig spacing".
   * Teorigenomgången bredvid använder <slot /> och drabbas inte, eftersom
   * Astro sätter cid på det innehållet.
   * Skriver du en ny regel här: wrappa elementdelen i :global(). */
  .we-body { line-height: 1.65; color: var(--ink); }
  .we-body :global(:first-child) { margin-top: 0; }
  .we-body :global(:last-child) { margin-bottom: 0; }
  .we-body :global(p) { margin: 10px 0; }
  .we-body :global(h1), .we-body :global(h2),
  .we-body :global(h3), .we-body :global(h4) {
    font-family: var(--font-display);
    color: var(--ink);
    letter-spacing: -0.01em;
    margin: 18px 0 6px;
  }
  .we-body :global(h1) { font-size: 20px; }
  .we-body :global(h2) { font-size: 17px; }
  .we-body :global(h3) { font-size: 15px; }
  .we-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--bg-soft);
    border-radius: 4px;
    padding: 1px 5px;
  }
  .we-body :global(pre) {
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.55;
    margin: 12px 0;
  }
  .we-body :global(pre code) {
    background: none;
    padding: 0;
  }
  .we-body :global(ul), .we-body :global(ol) {
    margin: 10px 0;
    padding-left: 22px;
  }
  .we-body :global(li) { margin: 4px 0; }
  .we-body :global(strong) { color: var(--ink); font-weight: 700; }
  /* Tabellen är kärnan i en genomgång — steg, varför, resultat. */
  .we-body :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 14px 0;
    font-size: 14px;
  }
  .we-body :global(th), .we-body :global(td) {
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .we-body :global(th) {
    background: var(--bg-soft);
    font-weight: 600;
    color: var(--ink-soft);
    border-bottom: 2px solid var(--line-strong);
  }
  .we-body :global(td:first-child) {
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }
  .we-body :global(blockquote) {
    margin: 14px 0;
    padding: 10px 14px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--ink);
    font-style: italic;
  }
</style>
